# --- required ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=          # only if Claude says the key 'is not scoped to a workspace'
BOT_TOKEN=                      # from @BotFather: Toshmat aka (manager); also posts to the channel
FINDER_BOT_TOKEN=               # optional: Eshmat's own bot (else he talks through Toshmat aka's bot)
WRITER_BOT_TOKEN=               # optional: Mirzo's own bot
COMMUNITY_BOT_TOKEN=            # GrantBek: people DM this bot; add it as admin to the channel's comments group
ADMIN_CHAT_ID=                  # your private editors group (send /help to the bot there to see it)
ADMIN_USER_IDS=                 # comma separated Telegram user ids allowed to approve; empty = anyone in the group
CHANNEL_ID=@EduGrandsUz         # the bot must be an admin of the channel with "Post messages"
CHANNEL_HANDLE=@EduGrandsUz

# --- models (defaults are fine) --------------------------------------------
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_WRITER=claude-sonnet-5-5
# Toshmat aka (orders typed in the group). Empty = MODEL_WRITER.
MODEL_MANAGER=

# --- finder rules --------------------------------------------------------------
MODE=finder                     # finder = send finds only; full = also write and publish posts
# Always on: Uzbeks can apply + no application fee. Everything below is optional and off by default.
REQUIRE_UZ_YES=false            # true = also drop items whose Uzbekistan eligibility is unclear
REQUIRE_FREE_PARTICIPATION=false  # true = drop anything the participant has to pay for
ALLOW_FULL_AID=false            # with the line above: also allow paid programmes with full financial aid
CHECK_AGES=true                 # keep: ages overlap AGE_MIN-AGE_MAX, or for school/bachelor students
AGE_MIN=10
AGE_MAX=20                        # the programme must accept someone this young: 18-35 in, 21-30 out
MIN_FIT_SCORE=3                 # 1-5 vs the channel's vibe, judged from the title: below this it isn't even researched
MIN_SHOW_FIT=4                  # only finds scored at least this high reach the dashboard queue
RESEARCH_MIN_PER_RUN=12         # quiet day: research at least this many (best "fit 2" ones fill up), shown as Zaxira
GRAD_ONLY_MIN_FIT=6             # master's/PhD-only: 6 = never, unless the channel posted it before
RECENT_POST_DAYS=60             # don't suggest programmes posted within this many days
AUTO_WRITE_PER_DAY=3            # Toshmat aka gives up to 3 strong finds (score 5) a day straight to Mirzo; 0 = off
WRITE_ON_ACCEPT=true            # ✅ Olamiz also writes the post in the channel format
MONTHLY_FIXED_COST=0            # e.g. 5 = Railway $5/month, shown next to the AI cost on the dashboard

# --- behaviour ---------------------------------------------------------------
RUN_AT=09:00                    # one search a day at this time
COMMUNITY_REFRESH_AT=06:30      # GrantBek re-reads the channel and relearns the week's questions
REPORT_AT=21:00                 # Toshmat aka's daily report
WEEKLY_AT=mon 08:30             # Mirzo's "Bu hafta muddati tugaydigan dasturlar" list (day + time)
TIMEZONE=Asia/Tashkent
RUN_EVERY_HOURS=24              # used only if RUN_AT is empty
MIN_DAYS_LEFT=4                 # skip grants closing sooner than this
DB_PATH=data/agent.db

# --- edugrants.uz ------------------------------------------------------------
# Leave empty to save approved listings as JSON files in data/platform_exports/
PLATFORM_WEBHOOK_URL=
PLATFORM_TOKEN=

# --- optional sources ------------------------------------------------------------
# --- reading Telegram channels (needed for the channel sources) ------------------
# Use a spare Telegram account. Get the id/hash at my.telegram.org -> API development tools,
# then run `python -m edugrants_agent tg-login` once on your computer and paste the result here.
TG_API_ID=
TG_API_HASH=
TG_STRING_SESSION=
FAST_EVERY_MINUTES=0            # 0 = off; e.g. 60 to also check Telegram channels every hour
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=                  # Gmail app password
